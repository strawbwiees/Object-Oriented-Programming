Console.WriteLine("PROGRAM 4");

Console.Write("Enter a number: ");

double number = double.Parse(Console.ReadLine());

Console.WriteLine("Square root: " + Math.Sqrt(number));
Console.WriteLine("Square: " + Math.Pow(number, 2));
Console.WriteLine("Cube: " + Math.Pow(number, 3));
Console.WriteLine("Absolute value: " + Math.Abs(number));
Console.WriteLine("Rounded Value: " + Math.Round(number));
Console.WriteLine("Sine: " + Math.Sin(number));
Console.WriteLine("Cosine: " + Math.Cos(number));
Console.WriteLine("Tangent: " + Math.Tan(number));
